# ═══════════════════════════════════════════
# Aravali Interiors Backend — Environment
# ═══════════════════════════════════════════

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,https://aravali.in

# Database (PostgreSQL)
DATABASE_URL=postgresql://aravali:password@localhost:5432/aravali_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Auth
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=aravali-uploads
S3_PORTFOLIO_BUCKET=aravali-portfolio

# SendGrid Email
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=projects@aravali.in
SENDGRID_FROM_NAME=Aravali Interiors

# CRM Integration
HUBSPOT_API_KEY=
HUBSPOT_PIPELINE_ID=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
CRM_PROVIDER=hubspot  # hubspot | salesforce | webhook

# CRM Webhook (if CRM_PROVIDER=webhook)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=projects@aravali.in

# Microsoft Outlook Calendar
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# Slack Notifications (high-priority leads)
SLACK_WEBHOOK_URL=

# Rate Limiting
THROTTLE_TTL=3600
THROTTLE_LIMIT=5

# Frontend URL (for email links)
FRONTEND_URL=https://aravali.in
